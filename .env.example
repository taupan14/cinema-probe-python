# Supabase credentials (required untuk save ke DB)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_service_key_here

# Output settings
OUTPUT_DIR=./output
SAVE_TO_DB=false         # set true untuk langsung ke Supabase
SAVE_TO_JSON=true        # simpan hasil ke JSON lokal
SAVE_TO_CSV=true         # simpan hasil ke CSV lokal

# Scraper settings
CONCURRENT_REQUESTS=5    # max request paralel per scraper
REQUEST_DELAY=1.5        # detik antar request (hindari rate limit)
REQUEST_TIMEOUT=30       # timeout per request (detik)
MAX_RETRIES=3            # max retry jika request gagal
